{
  "name": "taxiroute",
  "version": "0.1.0",
  "private": true,
  "description": "TaxiRoute – B2B-Auftragsbörse für Taxi-/Transferunternehmen und Reisebüros",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "vercel-build": "if [ -n \"$DATABASE_URL\" ]; then prisma migrate deploy; fi && next build",
    "lint": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:demo": "tsx prisma/demo-boerse.ts",
    "test": "dotenv -e .env.test -- prisma migrate deploy && dotenv -e .env.test -- vitest run",
    "test:watch": "dotenv -e .env.test -- vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/albert-sans": "^5.3.0",
    "@fontsource-variable/imbue": "^5.3.0",
    "@maplibre/maplibre-gl-leaflet": "^0.0.22",
    "@prisma/client": "^6.19.3",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^4.7.1",
    "next": "^15.5.28",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
