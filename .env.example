DATABASE_URL="postgresql://taxiroute:taxiroute@localhost:5432/taxiroute_dev"

# Optional: E-Mail-Versand über Resend. Ohne Schlüssel landen E-Mails nur im Server-Log.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="TaxiRoute <noreply@taxiroute.at>"
# Öffentliche Adresse für Links in E-Mails
# APP_URL="http://localhost:3000"

# Optional: Mitteilungen aufs Gerät (Web-Push). Schlüsselpaar erzeugen mit: npx web-push generate-vapid-keys
# Ohne Schlüssel bietet die App das Einschalten nicht an, E-Mails gehen weiter wie bisher.
# VAPID_PUBLIC_KEY="..."
# VAPID_PRIVATE_KEY="..."
# VAPID_SUBJECT="mailto:office@example.com"
# Optional: Mitteilungen an die native Fahrer-App über Firebase Cloud Messaging (siehe mobile/README.md)
# FIREBASE_SERVICE_ACCOUNT='{"project_id":"...","client_email":"...","private_key":"..."}'
