// Transferborsa – Datenmodell Phase 2: Organisationen, Nutzer, Rollen, Verifizierung.
// Spätere Phasen (Aufträge, Angebote, Buchungen, Kapazitäten) bauen auf
// Organization/Membership auf und erhalten eigene Modelle.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Primärer Typ einer Organisation. Bestimmt Onboarding und Standard-Dashboard,
/// NICHT die Berechtigungen – diese ergeben sich aus OrganizationCapability.
enum OrganizationType {
  TRANSPORT_COMPANY
  TRAVEL_AGENCY
  TOUR_OPERATOR
  HOTEL
}

/// Kontostatus einer Organisation, vom Plattformadmin gesteuert.
enum OrganizationStatus {
  ACTIVE
  RESTRICTED
  SUSPENDED
}

/// Abo-Tarif für Taxi-/Transferunternehmen (netto pro Monat, siehe src/lib/plans.ts).
/// Reisebüros und Hotels nutzen die Plattform kostenlos und haben keinen Tarif.
enum SubscriptionPlan {
  BASIS
  PRO
  FLOTTE
}

/// Geschäftsfunktionen, die eine Organisation auf der Plattform nutzen darf.
/// Jede Funktion wird separat verifiziert (Mischbetriebe!).
enum Capability {
  /// Führt Beförderungen durch: Fahrzeuge, Kapazitäten, Auftragsübernahme.
  TRANSPORT_PROVIDER
  /// Fragt Transfers an und bucht sie (Reisebüro, Taxiunternehmen als Auftraggeber).
  TRANSFER_BOOKER
}

enum VerificationStatus {
  UNVERIFIED
  PENDING_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum MemberRole {
  OWNER
  ADMIN
  DISPATCHER
  BOOKER
  FINANCE
  VIEWER
  /// Fahrer: sieht nur die eigenen zugewiesenen Fahrten und teilt während der Schicht den Standort
  DRIVER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum DocumentType {
  BUSINESS_LICENSE
  TAXI_CONCESSION
  RENTAL_CAR_LICENSE
  INSURANCE
  COMMERCIAL_REGISTER
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VehicleCategory {
  SEDAN
  ESTATE
  MINIVAN
  VAN
  MINIBUS
  BUS
  LUXURY
  WHEELCHAIR
}

model User {
  id                String               @id @default(cuid())
  email             String               @unique
  name              String
  phone             String?
  passwordHash      String
  status            UserStatus           @default(ACTIVE)
  isPlatformAdmin   Boolean              @default(false)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  memberships       Membership[]
  sessions          Session[]
  passwordResets    PasswordResetToken[]
  driverBookings    Booking[]            @relation("DriverBookings")
  driverShifts      DriverShift[]
  pushSubscriptions PushSubscription[]
}

/// Ein Gerät, das Mitteilungen erhält. WEB: Web-Push (Browser, PWA) mit Endpunkt und Schlüsseln.
/// IOS/ANDROID: die native App, `endpoint` ist dann das Geräte-Token des Push-Dienstes.
enum PushPlatform {
  WEB
  IOS
  ANDROID
}

model PushSubscription {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Mitteilungen gelten für dieses Unternehmen (das beim Einschalten aktive)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Anmeldung, mit der das Gerät eingeschaltet wurde: Abmelden schaltet die Mitteilungen dort ab.
  sessionId      String?
  session        Session?     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  platform       PushPlatform @default(WEB)
  endpoint       String       @unique
  p256dh         String?
  auth           String?
  createdAt      DateTime     @default(now())
  lastSentAt     DateTime?

  @@index([organizationId])
  @@index([userId])
}

/// Einmal-Link zum Zurücksetzen des Passworts. Gespeichert wird nur der SHA-256 des Tokens.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Versuche je Schlüssel (z. B. "login:email:…", "login:ip:…") für einfaches, instanzübergreifendes Rate-Limiting.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Session {
  /// SHA-256 des Session-Tokens; das Klartext-Token existiert nur im Cookie.
  id                String             @id
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrgId       String?
  activeOrg         Organization?      @relation(fields: [activeOrgId], references: [id], onDelete: SetNull)
  expiresAt         DateTime
  createdAt         DateTime           @default(now())
  pushSubscriptions PushSubscription[]

  @@index([userId])
}

model Organization {
  id             String             @id @default(cuid())
  type           OrganizationType
  status         OrganizationStatus @default(ACTIVE)
  name           String
  legalName      String?
  street         String
  postalCode     String
  city           String
  /// ISO-3166-1 alpha-2, z. B. AT, DE, IT, CH
  country        String
  email          String
  phone          String
  website        String?
  vatId          String?
  registerNumber String?
  contactPerson  String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  /// Vom Plattform-Admin manuell zugewiesener Tarif (vorerst Zahlung per Rechnung, kein Stripe).
  plan          SubscriptionPlan?
  /// Bis zu diesem Tag (einschließlich) kostenlos, z. B. für Pilotunternehmen. Danach gilt der Tarif.
  planFreeUntil DateTime?
  /// Interne Notiz zum Tarif, z. B. vereinbarter Rabatt. Nur für Admins sichtbar.
  planNote      String?
  planUpdatedAt DateTime?

  /// E-Mail bei neuen Börsenaufträgen. Gespeicherte Strecken (Suchagent) stehen in JobAlert: keine = alle Orte.
  mailNewJobs Boolean @default(true)

  capabilities     OrganizationCapability[]
  memberships      Membership[]
  invitations      Invitation[]
  documents        VerificationDocument[]
  transportProfile TransportProfile?
  sessions         Session[]
  auditEvents      AuditEvent[]

  vehicles          Vehicle[]
  requests          TransferRequest[]  @relation("RequesterRequests")
  quotes            Quote[]            @relation("ProviderQuotes")
  quoteInvitations  QuoteInvitation[]  @relation("ProviderInvitations")
  requesterBookings Booking[]          @relation("RequesterBookings")
  providerBookings  Booking[]          @relation("ProviderBookings")
  capacityOffers    CapacityOffer[]
  driverShifts      DriverShift[]
  partners          PartnerLink[]      @relation("OwnPartners")
  partnerOf         PartnerLink[]      @relation("PartnerOf")
  blocks            OrgBlock[]         @relation("OwnBlocks")
  messagesSent      Message[]          @relation("MessagesSent")
  messagesThread    Message[]          @relation("MessagesThread")
  blockedBy         OrgBlock[]         @relation("BlockedBy")
  pushSubscriptions PushSubscription[]
  ratingsReceived   Rating[]           @relation("RatingsReceived")
  jobAlerts         JobAlert[]
  locations         OrgLocation[]
  tenders           Tender[]
  tenderBids        TenderBid[]
}

/// Sperrliste: gesperrte Unternehmen sehen keine Aufträge dieses Unternehmens.
model OrgBlock {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation("OwnBlocks", fields: [orgId], references: [id], onDelete: Cascade)
  blockedOrgId String
  blockedOrg   Organization @relation("BlockedBy", fields: [blockedOrgId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())

  @@unique([orgId, blockedOrgId])
  @@index([blockedOrgId])
}

/// Eigenes Partnernetzwerk: Unternehmen, die ein Betrieb in Stufe 2 zuerst sehen lässt (einseitig, ohne Zustimmung).
model PartnerLink {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation("OwnPartners", fields: [orgId], references: [id], onDelete: Cascade)
  partnerOrgId String
  partnerOrg   Organization @relation("PartnerOf", fields: [partnerOrgId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())

  @@unique([orgId, partnerOrgId])
  @@index([partnerOrgId])
}

model OrganizationCapability {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  capability     Capability
  status         VerificationStatus @default(UNVERIFIED)
  reviewNote     String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([organizationId, capability])
}

/// Zusatzdaten für Beförderungsunternehmen.
model TransportProfile {
  organizationId    String            @id
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  concessionNumber  String?
  vehicleCategories VehicleCategory[]
  /// Selbstangabe des Unternehmens (z. B. "AT-7 Tirol", "DE-BY"); wird separat geprüft.
  declaredRegions   String[]
  fleetSize         Int?
  updatedAt         DateTime          @updatedAt
}

model Membership {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role              MemberRole
  /// Zustimmung des Fahrers zur Standortfreigabe während der Schicht
  trackingConsentAt DateTime?
  createdAt         DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           MemberRole
  /// SHA-256 des Einladungs-Tokens
  tokenHash      String       @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model VerificationDocument {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           DocumentType
  title          String
  fileName       String
  mimeType       String
  sizeBytes      Int
  /// MVP: Datei in der DB, damit jeder Zugriff serverseitig geprüft wird.
  /// Später: Objektspeicher mit signierten URLs.
  content        Bytes
  validUntil     DateTime?
  /// Ablaufwarnung: 0 = keine, 1 = Hinweis 30 Tage vorher gesendet, 2 = Hinweis zum Ablauf gesendet
  expiryNotice   Int            @default(0)
  status         DocumentStatus @default(PENDING)
  reviewNote     String?
  reviewedById   String?
  reviewedAt     DateTime?
  uploadedById   String
  createdAt      DateTime       @default(now())

  @@index([organizationId])
}

/// Nachvollziehbare Protokollierung sicherheits- und geschäftsrelevanter Aktionen.
model AuditEvent {
  id             String        @id @default(cuid())
  actorUserId    String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  action         String
  targetType     String?
  targetId       String?
  data           Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 3: Auftragsbörse
// ---------------------------------------------------------------------------

/// Festpreis: direkt übernehmbar. Verhandelbar: Unternehmen geben Angebote ab.
enum PriceMode {
  FIXED
  NEGOTIABLE
}

enum TransferStatus {
  /// In der Börse sichtbar, wartet auf Übernahme oder Angebote
  OPEN
  /// Verbindlich vergeben (Buchung existiert)
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
  /// Fahrgast nicht erschienen
  NO_SHOW
}

/// Wer einen Auftrag sieht: alle geprüften Unternehmen in der Börse oder nur die eingeladenen.
enum RequestVisibility {
  MARKET
  INVITED
}

/// Stufe der Veröffentlichung: erst der eigene Betrieb, dann ausgewählte Partner, dann die gesamte Börse.
enum Audience {
  OWN
  PARTNERS
  MARKET
}

enum InvitationStatus {
  /// Eingeladen, noch keine Reaktion
  PENDING
  /// Angebot abgegeben bzw. Auftrag übernommen
  RESPONDED
  /// Eingeladenes Unternehmen hat abgelehnt
  DECLINED
}

enum QuoteStatus {
  SUBMITTED
  WITHDRAWN
  ACCEPTED
  REJECTED
}

enum BookingStatus {
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
  /// Fahrgast nicht erschienen (vom ausführenden Unternehmen gemeldet)
  NO_SHOW
}

enum CapacityStatus {
  /// Geplant, aber noch nicht vom Unternehmen als verbindlich bestätigt
  PLANNED
  /// Vom Unternehmen bestätigt: Fahrzeug und Fahrer stehen fest
  CONFIRMED
  WITHDRAWN
}

model Vehicle {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label          String
  category       VehicleCategory
  licensePlate   String?
  seats          Int
  luggage        Int
  skiCapacity    Int             @default(0)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  capacities     CapacityOffer[]
  bookings       Booking[]
  driverShifts   DriverShift[]

  @@index([organizationId])
}

/// Transferauftrag bzw. Transferanfrage. Orte stammen aus dem Ortskatalog (src/lib/places.ts).
model TransferRequest {
  id             String         @id @default(cuid())
  number         Int            @unique @default(autoincrement())
  requesterOrgId String
  requesterOrg   Organization   @relation("RequesterRequests", fields: [requesterOrgId], references: [id], onDelete: Cascade)
  createdById    String
  status         TransferStatus @default(OPEN)

  pickupPlaceId       String
  dropoffPlaceId      String
  /// Genaue Adressen: nur für Auftraggeber und ausführendes Unternehmen sichtbar
  pickupAddress       String?
  dropoffAddress      String?
  pickupAt            DateTime
  pickupWindowMinutes Int      @default(0)
  estimatedMinutes    Int?

  passengers      Int
  luggage         Int              @default(0)
  skiEquipment    Int              @default(0)
  specialLuggage  String?
  vehicleCategory VehicleCategory?
  childSeats      Int              @default(0)
  requirements    String?
  flightNumber    String?
  flightArrivalAt DateTime?
  pickupNotes     String?

  priceMode            PriceMode
  /// Festpreis bzw. unverbindlicher Richtpreis/Budget in Cent
  priceCents           Int?
  currency             String            @default("EUR")
  /// Anteil in Prozent, den das abgebende Unternehmen vom Fahrpreis behält (0 = keiner).
  /// Abrechnung direkt zwischen den Unternehmen, die Plattform erhält nichts davon.
  handoffSharePercent  Int               @default(0)
  quoteDeadline        DateTime?
  bookingTerms         String?
  cancellationTerms    String?
  /// Stornoregel: kostenlos bis so viele Stunden vor Abholung (null = keine feste Regel)
  freeCancelHours      Int?
  /// Stornoregel: danach so viel Prozent des Fahrpreises (0, 50 oder 100)
  lateCancelPercent    Int?
  clientReference      String?
  /// MARKET: in der Börse; INVITED: nur für die Unternehmen in QuoteInvitation sichtbar
  visibility           RequestVisibility @default(MARKET)
  /// Aktuelle Stufe (nur bei MARKET-Aufträgen): OWN nur eigener Betrieb, PARTNERS eigene Partner, MARKET alle.
  audience             Audience          @default(MARKET)
  audienceSince        DateTime          @default(now())
  /// Nach so vielen Minuten ohne Übernahme geht der Auftrag automatisch zur nächsten Stufe (null = nie)
  escalateAfterMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passengersContact PassengerContact[]
  quotes            Quote[]
  booking           Booking?
  events            TransferEvent[]
  invitations       QuoteInvitation[]
  messages          Message[]

  @@index([status, pickupAt])
  @@index([requesterOrgId])
}

/// Sensible Fahrgastdaten, getrennt gespeichert und nur für Beteiligte sichtbar.
model PassengerContact {
  id        String          @id @default(cuid())
  requestId String
  request   TransferRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  name      String
  phone     String?

  @@index([requestId])
}

model Quote {
  id              String          @id @default(cuid())
  requestId       String
  request         TransferRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  providerOrgId   String
  providerOrg     Organization    @relation("ProviderQuotes", fields: [providerOrgId], references: [id], onDelete: Cascade)
  createdById     String
  amountCents     Int
  vehicleCategory VehicleCategory
  message         String?
  validUntil      DateTime?
  status          QuoteStatus     @default(SUBMITTED)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  booking         Booking?

  /// Ein Angebot je Unternehmen und Auftrag (neu abgeben ersetzt das alte)
  @@unique([requestId, providerOrgId])
}

/// Gezielte Angebotsanfrage an ein bestimmtes Beförderungsunternehmen (Szenario B).
model QuoteInvitation {
  id            String           @id @default(cuid())
  requestId     String
  request       TransferRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  providerOrgId String
  providerOrg   Organization     @relation("ProviderInvitations", fields: [providerOrgId], references: [id], onDelete: Cascade)
  invitedById   String
  status        InvitationStatus @default(PENDING)
  declineNote   String?
  createdAt     DateTime         @default(now())
  respondedAt   DateTime?

  @@unique([requestId, providerOrgId])
  @@index([providerOrgId, status])
}

/// Verbindliche Vereinbarung. requestId ist eindeutig: ein Auftrag kann nur einmal vergeben werden.
model Booking {
  id                  String          @id @default(cuid())
  requestId           String          @unique
  request             TransferRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  quoteId             String?         @unique
  quote               Quote?          @relation(fields: [quoteId], references: [id])
  requesterOrgId      String
  requesterOrg        Organization    @relation("RequesterBookings", fields: [requesterOrgId], references: [id])
  providerOrgId       String
  providerOrg         Organization    @relation("ProviderBookings", fields: [providerOrgId], references: [id])
  vehicleId           String?
  vehicle             Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  /// Vom Disponenten zugewiesener Fahrer (Mitglied des ausführenden Unternehmens)
  driverId            String?
  driver              User?           @relation("DriverBookings", fields: [driverId], references: [id], onDelete: SetNull)
  /// Fortschritt laut Fahrer, solange die Fahrt läuft
  tripStage           TripStage?
  tripStageAt         DateTime?
  capacityOfferId     String?
  agreedPriceCents    Int
  /// Abgabe-Anteil zum Zeitpunkt der Vereinbarung (unveränderlich): Prozent und Betrag in Cent.
  /// Das ausführende Unternehmen erhält agreedPriceCents minus handoffShareCents.
  handoffSharePercent Int             @default(0)
  handoffShareCents   Int             @default(0)
  currency            String          @default("EUR")
  /// Leistungsumfang zum Zeitpunkt der Annahme (unveränderlich)
  scope               Json
  cancellationTerms   String?
  /// Stornoregel zum Zeitpunkt der Annahme (unveränderlich), siehe TransferRequest
  freeCancelHours     Int?
  lateCancelPercent   Int?
  /// Spätstorno- oder No-Show-Gebühr in Cent, vom Auftraggeber an das ausführende Unternehmen.
  /// Wird nur berechnet und festgehalten, bezahlt wird direkt zwischen den Firmen.
  feeCents            Int?
  cancelledAt         DateTime?
  cancelledByOrgId    String?
  status              BookingStatus   @default(CONFIRMED)
  acceptedAt          DateTime        @default(now())
  acceptedById        String
  completedAt         DateTime?
  completionNote      String?
  /// Geheimer Schlüssel für den Live-Status-Link (/t/…), den Auftraggeber und Fahrgast ohne Login öffnen.
  trackToken          String          @unique @default(dbgenerated("replace((gen_random_uuid())::text, '-'::text, ''::text)"))

  documents BookingDocument[]
  ratings   Rating[]

  @@index([providerOrgId])
  @@index([requesterOrgId])
  @@index([driverId])
}

/// Nachricht zu einem Auftrag zwischen Auftraggeber und einem Beförderungsunternehmen (Rückfrage oder Absprache).
/// Ein Verlauf je Auftrag und Gegenüber (threadOrgId = das Unternehmen, das nicht der Auftraggeber ist).
model Message {
  id           String          @id @default(cuid())
  requestId    String
  request      TransferRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  threadOrgId  String
  threadOrg    Organization    @relation("MessagesThread", fields: [threadOrgId], references: [id], onDelete: Cascade)
  senderOrgId  String
  senderOrg    Organization    @relation("MessagesSent", fields: [senderOrgId], references: [id], onDelete: Cascade)
  senderUserId String
  body         String
  createdAt    DateTime        @default(now())

  @@index([requestId, threadOrgId, createdAt])
}

/// Dokument zu einer Buchung (z. B. Voucher, Flugticket, Beleg), sichtbar für beide beteiligten Unternehmen.
model BookingDocument {
  id            String   @id @default(cuid())
  bookingId     String
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  uploadedOrgId String
  uploadedById  String
  title         String
  fileName      String
  mimeType      String
  sizeBytes     Int
  content       Bytes
  createdAt     DateTime @default(now())

  @@index([bookingId])
}

/// Nachvollziehbare Ereignisse je Auftrag (Erstellung, Angebote, Vergabe, Statuswechsel).
model TransferEvent {
  id          String          @id @default(cuid())
  requestId   String
  request     TransferRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  type        String
  actorOrgId  String?
  actorUserId String?
  data        Json?
  createdAt   DateTime        @default(now())

  @@index([requestId, createdAt])
}

/// Freie Kapazität bzw. geplante (Rück-)Fahrt eines Beförderungsunternehmens.
model CapacityOffer {
  id               String          @id @default(cuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById      String
  vehicleId        String?
  vehicle          Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleCategory  VehicleCategory
  fromPlaceId      String
  toPlaceId        String
  availableFrom    DateTime
  availableUntil   DateTime
  seats            Int
  luggage          Int
  maxDetourMinutes Int             @default(20)
  maxWaitMinutes   Int             @default(60)
  note             String?
  status           CapacityStatus  @default(PLANNED)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status, availableFrom])
  @@index([organizationId])
}

enum TripStage {
  TO_PICKUP
  AT_PICKUP
  ON_BOARD
}

/// Schicht eines Fahrers. Nur während einer offenen Schicht wird der Standort übertragen und
/// dem eigenen Unternehmen angezeigt. Die letzte Position steht direkt an der Schicht.
model DriverShift {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId      String?
  vehicle        Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  startedAt      DateTime     @default(now())
  endedAt        DateTime?

  lastLat        Float?
  lastLng        Float?
  lastAccuracy   Float?
  lastSpeed      Float?
  lastHeading    Float?
  lastPositionAt DateTime?

  positions PositionPing[]

  @@index([organizationId, endedAt])
  @@index([userId, endedAt])
}

/// Standortverlauf je Schicht; wird nach POSITION_RETENTION_DAYS gelöscht.
model PositionPing {
  id         BigInt      @id @default(autoincrement())
  shiftId    String
  shift      DriverShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  accuracy   Float?
  speed      Float?
  heading    Float?
  recordedAt DateTime

  @@index([shiftId, recordedAt])
  @@index([recordedAt])
}

/// Bewertung nach der Fahrt: jede der beiden Firmen bewertet die andere einmal je Buchung (1 bis 5 Sterne).
model Rating {
  id        String       @id @default(cuid())
  bookingId String
  booking   Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromOrgId String
  toOrgId   String
  toOrg     Organization @relation("RatingsReceived", fields: [toOrgId], references: [id], onDelete: Cascade)
  createdBy String
  stars     Int
  comment   String?
  createdAt DateTime     @default(now())

  @@unique([bookingId, fromOrgId])
  @@index([toOrgId])
}

/// Suchagent: gespeicherte Strecke eines Betriebs. Neue Aufträge werden nur gemeldet, wenn eine der
/// gespeicherten Strecken passt (leeres Feld = egal). Ohne gespeicherte Strecke werden alle gemeldet.
model JobAlert {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromPlaceId    String?
  toPlaceId      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

/// Standort eines Betriebs (Ort aus dem Ortskatalog). Dient der Suche „in meiner Nähe“ in der Börse
/// und steht im Firmenverzeichnis. Der Firmensitz bleibt die Adresse am Unternehmen.
model OrgLocation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  placeId        String
  createdAt      DateTime     @default(now())

  @@unique([organizationId, placeId])
}

enum TenderStatus {
  OPEN
  AWARDED
  CLOSED
}

/// Ausschreibung: ein Auftraggeber schreibt viele Fahrten auf einer Strecke für einen Zeitraum aus
/// (Saison- oder Gruppentransfers). Betriebe bieten einen festen Preis je Fahrt, einer erhält den Zuschlag.
/// Die einzelnen Fahrten stellt der Auftraggeber danach als gezielte Aufträge an diesen Betrieb ein.
model Tender {
  id              String           @id @default(cuid())
  number          Int              @unique @default(autoincrement())
  requesterOrgId  String
  requesterOrg    Organization     @relation(fields: [requesterOrgId], references: [id], onDelete: Cascade)
  createdById     String
  pickupPlaceId   String
  dropoffPlaceId  String
  bothDirections  Boolean          @default(true)
  dateFrom        DateTime
  dateTo          DateTime
  estimatedTrips  Int
  passengers      Int?
  vehicleCategory VehicleCategory?
  notes           String?
  bidDeadline     DateTime
  status          TenderStatus     @default(OPEN)
  awardedBidId    String?          @unique
  awardedBid      TenderBid?       @relation("AwardedBid", fields: [awardedBidId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  bids TenderBid[]

  @@index([requesterOrgId])
  @@index([status, bidDeadline])
}

model TenderBid {
  id                String       @id @default(cuid())
  tenderId          String
  tender            Tender       @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  providerOrgId     String
  providerOrg       Organization @relation(fields: [providerOrgId], references: [id], onDelete: Cascade)
  createdById       String
  pricePerTripCents Int
  message           String?
  status            QuoteStatus  @default(SUBMITTED)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  awardedFor Tender? @relation("AwardedBid")

  /// Ein Angebot je Betrieb und Ausschreibung (neu abgeben ersetzt das alte)
  @@unique([tenderId, providerOrgId])
  @@index([providerOrgId])
}
