// Transferborsa – Datenmodell Phase 2: Organisationen, Nutzer, Rollen, Verifizierung.
// Spätere Phasen (Aufträge, Angebote, Buchungen, Kapazitäten) bauen auf
// Organization/Membership auf und erhalten eigene Modelle.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Primärer Typ einer Organisation. Bestimmt Onboarding und Standard-Dashboard,
/// NICHT die Berechtigungen – diese ergeben sich aus OrganizationCapability.
enum OrganizationType {
  TRANSPORT_COMPANY
  TRAVEL_AGENCY
  TOUR_OPERATOR
  HOTEL
}

/// Kontostatus einer Organisation, vom Plattformadmin gesteuert.
enum OrganizationStatus {
  ACTIVE
  RESTRICTED
  SUSPENDED
}

/// Geschäftsfunktionen, die eine Organisation auf der Plattform nutzen darf.
/// Jede Funktion wird separat verifiziert (Mischbetriebe!).
enum Capability {
  /// Führt Beförderungen durch: Fahrzeuge, Kapazitäten, Auftragsübernahme.
  TRANSPORT_PROVIDER
  /// Fragt Transfers an und bucht sie (Reisebüro, Taxiunternehmen als Auftraggeber).
  TRANSFER_BOOKER
}

enum VerificationStatus {
  UNVERIFIED
  PENDING_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum MemberRole {
  OWNER
  ADMIN
  DISPATCHER
  BOOKER
  FINANCE
  VIEWER
  /// Fahrer: sieht nur die eigenen zugewiesenen Fahrten und teilt während der Schicht den Standort
  DRIVER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum DocumentType {
  BUSINESS_LICENSE
  TAXI_CONCESSION
  RENTAL_CAR_LICENSE
  INSURANCE
  COMMERCIAL_REGISTER
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VehicleCategory {
  SEDAN
  ESTATE
  MINIVAN
  VAN
  MINIBUS
  BUS
  LUXURY
  WHEELCHAIR
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  name            String
  phone           String?
  passwordHash    String
  status          UserStatus   @default(ACTIVE)
  isPlatformAdmin Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  memberships     Membership[]
  sessions        Session[]
  passwordResets  PasswordResetToken[]
  driverBookings  Booking[]            @relation("DriverBookings")
  driverShifts    DriverShift[]
}

/// Einmal-Link zum Zurücksetzen des Passworts. Gespeichert wird nur der SHA-256 des Tokens.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Versuche je Schlüssel (z. B. "login:email:…", "login:ip:…") für einfaches, instanzübergreifendes Rate-Limiting.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Session {
  /// SHA-256 des Session-Tokens; das Klartext-Token existiert nur im Cookie.
  id          String        @id
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrgId String?
  activeOrg   Organization? @relation(fields: [activeOrgId], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  createdAt   DateTime      @default(now())

  @@index([userId])
}

model Organization {
  id             String             @id @default(cuid())
  type           OrganizationType
  status         OrganizationStatus @default(ACTIVE)
  name           String
  legalName      String?
  street         String
  postalCode     String
  city           String
  /// ISO-3166-1 alpha-2, z. B. AT, DE, IT, CH
  country        String
  email          String
  phone          String
  website        String?
  vatId          String?
  registerNumber String?
  contactPerson  String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  capabilities     OrganizationCapability[]
  memberships      Membership[]
  invitations      Invitation[]
  documents        VerificationDocument[]
  transportProfile TransportProfile?
  sessions         Session[]
  auditEvents      AuditEvent[]

  vehicles          Vehicle[]
  requests          TransferRequest[] @relation("RequesterRequests")
  quotes            Quote[]           @relation("ProviderQuotes")
  quoteInvitations  QuoteInvitation[] @relation("ProviderInvitations")
  requesterBookings Booking[]         @relation("RequesterBookings")
  providerBookings  Booking[]         @relation("ProviderBookings")
  capacityOffers    CapacityOffer[]
  driverShifts      DriverShift[]
}

model OrganizationCapability {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  capability     Capability
  status         VerificationStatus @default(UNVERIFIED)
  reviewNote     String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([organizationId, capability])
}

/// Zusatzdaten für Beförderungsunternehmen.
model TransportProfile {
  organizationId    String            @id
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  concessionNumber  String?
  vehicleCategories VehicleCategory[]
  /// Selbstangabe des Unternehmens (z. B. "AT-7 Tirol", "DE-BY"); wird separat geprüft.
  declaredRegions   String[]
  fleetSize         Int?
  updatedAt         DateTime          @updatedAt
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           MemberRole
  /// Zustimmung des Fahrers zur Standortfreigabe während der Schicht
  trackingConsentAt DateTime?
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           MemberRole
  /// SHA-256 des Einladungs-Tokens
  tokenHash      String       @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model VerificationDocument {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           DocumentType
  title          String
  fileName       String
  mimeType       String
  sizeBytes      Int
  /// MVP: Datei in der DB, damit jeder Zugriff serverseitig geprüft wird.
  /// Später: Objektspeicher mit signierten URLs.
  content        Bytes
  validUntil     DateTime?
  status         DocumentStatus @default(PENDING)
  reviewNote     String?
  reviewedById   String?
  reviewedAt     DateTime?
  uploadedById   String
  createdAt      DateTime       @default(now())

  @@index([organizationId])
}

/// Nachvollziehbare Protokollierung sicherheits- und geschäftsrelevanter Aktionen.
model AuditEvent {
  id             String        @id @default(cuid())
  actorUserId    String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  action         String
  targetType     String?
  targetId       String?
  data           Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 3: Auftragsbörse
// ---------------------------------------------------------------------------

/// Festpreis: direkt übernehmbar. Verhandelbar: Unternehmen geben Angebote ab.
enum PriceMode {
  FIXED
  NEGOTIABLE
}

enum TransferStatus {
  /// In der Börse sichtbar, wartet auf Übernahme oder Angebote
  OPEN
  /// Verbindlich vergeben (Buchung existiert)
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

/// Wer einen Auftrag sieht: alle geprüften Unternehmen in der Börse oder nur die eingeladenen.
enum RequestVisibility {
  MARKET
  INVITED
}

enum InvitationStatus {
  /// Eingeladen, noch keine Reaktion
  PENDING
  /// Angebot abgegeben bzw. Auftrag übernommen
  RESPONDED
  /// Eingeladenes Unternehmen hat abgelehnt
  DECLINED
}

enum QuoteStatus {
  SUBMITTED
  WITHDRAWN
  ACCEPTED
  REJECTED
}

enum BookingStatus {
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum CapacityStatus {
  /// Geplant, aber noch nicht vom Unternehmen als verbindlich bestätigt
  PLANNED
  /// Vom Unternehmen bestätigt: Fahrzeug und Fahrer stehen fest
  CONFIRMED
  WITHDRAWN
}

model Vehicle {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label          String
  category       VehicleCategory
  licensePlate   String?
  seats          Int
  luggage        Int
  skiCapacity    Int             @default(0)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  capacities     CapacityOffer[]
  bookings       Booking[]
  driverShifts   DriverShift[]

  @@index([organizationId])
}

/// Transferauftrag bzw. Transferanfrage. Orte stammen aus dem Ortskatalog (src/lib/places.ts).
model TransferRequest {
  id             String         @id @default(cuid())
  number         Int            @unique @default(autoincrement())
  requesterOrgId String
  requesterOrg   Organization   @relation("RequesterRequests", fields: [requesterOrgId], references: [id], onDelete: Cascade)
  createdById    String
  status         TransferStatus @default(OPEN)

  pickupPlaceId       String
  dropoffPlaceId      String
  /// Genaue Adressen: nur für Auftraggeber und ausführendes Unternehmen sichtbar
  pickupAddress       String?
  dropoffAddress      String?
  pickupAt            DateTime
  pickupWindowMinutes Int      @default(0)
  estimatedMinutes    Int?

  passengers      Int
  luggage         Int              @default(0)
  skiEquipment    Int              @default(0)
  specialLuggage  String?
  vehicleCategory VehicleCategory?
  childSeats      Int              @default(0)
  requirements    String?
  flightNumber    String?
  flightArrivalAt DateTime?
  pickupNotes     String?

  priceMode         PriceMode
  /// Festpreis bzw. unverbindlicher Richtpreis/Budget in Cent
  priceCents        Int?
  currency          String    @default("EUR")
  quoteDeadline     DateTime?
  bookingTerms      String?
  cancellationTerms String?
  clientReference   String?
  /// MARKET: in der Börse; INVITED: nur für die Unternehmen in QuoteInvitation sichtbar
  visibility        RequestVisibility @default(MARKET)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passengersContact PassengerContact[]
  quotes            Quote[]
  booking           Booking?
  events            TransferEvent[]
  invitations       QuoteInvitation[]

  @@index([status, pickupAt])
  @@index([requesterOrgId])
}

/// Sensible Fahrgastdaten, getrennt gespeichert und nur für Beteiligte sichtbar.
model PassengerContact {
  id        String          @id @default(cuid())
  requestId String
  request   TransferRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  name      String
  phone     String?

  @@index([requestId])
}

model Quote {
  id              String          @id @default(cuid())
  requestId       String
  request         TransferRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  providerOrgId   String
  providerOrg     Organization    @relation("ProviderQuotes", fields: [providerOrgId], references: [id], onDelete: Cascade)
  createdById     String
  amountCents     Int
  vehicleCategory VehicleCategory
  message         String?
  validUntil      DateTime?
  status          QuoteStatus     @default(SUBMITTED)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  booking         Booking?

  /// Ein Angebot je Unternehmen und Auftrag (neu abgeben ersetzt das alte)
  @@unique([requestId, providerOrgId])
}

/// Gezielte Angebotsanfrage an ein bestimmtes Beförderungsunternehmen (Szenario B).
model QuoteInvitation {
  id            String           @id @default(cuid())
  requestId     String
  request       TransferRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  providerOrgId String
  providerOrg   Organization     @relation("ProviderInvitations", fields: [providerOrgId], references: [id], onDelete: Cascade)
  invitedById   String
  status        InvitationStatus @default(PENDING)
  declineNote   String?
  createdAt     DateTime         @default(now())
  respondedAt   DateTime?

  @@unique([requestId, providerOrgId])
  @@index([providerOrgId, status])
}

/// Verbindliche Vereinbarung. requestId ist eindeutig: ein Auftrag kann nur einmal vergeben werden.
model Booking {
  id                String          @id @default(cuid())
  requestId         String          @unique
  request           TransferRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  quoteId           String?         @unique
  quote             Quote?          @relation(fields: [quoteId], references: [id])
  requesterOrgId    String
  requesterOrg      Organization    @relation("RequesterBookings", fields: [requesterOrgId], references: [id])
  providerOrgId     String
  providerOrg       Organization    @relation("ProviderBookings", fields: [providerOrgId], references: [id])
  vehicleId         String?
  vehicle           Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  /// Vom Disponenten zugewiesener Fahrer (Mitglied des ausführenden Unternehmens)
  driverId          String?
  driver            User?           @relation("DriverBookings", fields: [driverId], references: [id], onDelete: SetNull)
  /// Fortschritt laut Fahrer, solange die Fahrt läuft
  tripStage         TripStage?
  tripStageAt       DateTime?
  capacityOfferId   String?
  agreedPriceCents  Int
  currency          String          @default("EUR")
  /// Leistungsumfang zum Zeitpunkt der Annahme (unveränderlich)
  scope             Json
  cancellationTerms String?
  status            BookingStatus   @default(CONFIRMED)
  acceptedAt        DateTime        @default(now())
  acceptedById      String
  completedAt       DateTime?
  completionNote    String?

  @@index([providerOrgId])
  @@index([requesterOrgId])
  @@index([driverId])
}

/// Nachvollziehbare Ereignisse je Auftrag (Erstellung, Angebote, Vergabe, Statuswechsel).
model TransferEvent {
  id          String          @id @default(cuid())
  requestId   String
  request     TransferRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  type        String
  actorOrgId  String?
  actorUserId String?
  data        Json?
  createdAt   DateTime        @default(now())

  @@index([requestId, createdAt])
}

/// Freie Kapazität bzw. geplante (Rück-)Fahrt eines Beförderungsunternehmens.
model CapacityOffer {
  id               String          @id @default(cuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById      String
  vehicleId        String?
  vehicle          Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleCategory  VehicleCategory
  fromPlaceId      String
  toPlaceId        String
  availableFrom    DateTime
  availableUntil   DateTime
  seats            Int
  luggage          Int
  maxDetourMinutes Int             @default(20)
  maxWaitMinutes   Int             @default(60)
  note             String?
  status           CapacityStatus  @default(PLANNED)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status, availableFrom])
  @@index([organizationId])
}

enum TripStage {
  TO_PICKUP
  AT_PICKUP
  ON_BOARD
}

/// Schicht eines Fahrers. Nur während einer offenen Schicht wird der Standort übertragen und
/// dem eigenen Unternehmen angezeigt. Die letzte Position steht direkt an der Schicht.
model DriverShift {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId      String?
  vehicle        Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  startedAt      DateTime     @default(now())
  endedAt        DateTime?

  lastLat        Float?
  lastLng        Float?
  lastAccuracy   Float?
  lastSpeed      Float?
  lastHeading    Float?
  lastPositionAt DateTime?

  positions PositionPing[]

  @@index([organizationId, endedAt])
  @@index([userId, endedAt])
}

/// Standortverlauf je Schicht; wird nach POSITION_RETENTION_DAYS gelöscht.
model PositionPing {
  id         BigInt      @id @default(autoincrement())
  shiftId    String
  shift      DriverShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  accuracy   Float?
  speed      Float?
  heading    Float?
  recordedAt DateTime

  @@index([shiftId, recordedAt])
  @@index([recordedAt])
}
